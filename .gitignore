# RStudio files
.Rproj.user
.Rhistory
.RData
.Ruserdata

# targets pipeline cache (never commit)
_targets/
.tar*

# renv: only lockfile should be kept
renv/library/
renv/staging/
renv/python/
renv/sandbox/

# OS / temporary files
.DS_Store
Thumbs.db

# Output files
outputs/
reports/

# Logs
*.log

# HTML / temp knitted files
*.utf8.md
*.knit.md
*.nb.html

# R package checking
.Rcheck/

# Packed files
*.tar.gz
*.zip

# Local data (do not commit)
data/

# Project-specific configs (use config/templates/ as reference)
config/*.yaml
!config/templates/*.yaml

# Third-party repos (referenced, not bundled)
claude-scientific-skills/

# Local scratch scripts
scripts/*.R

# User-specific environment variables
.Renviron

Rplots.pdf
Rplot.png
.lintr

# User-specific Claude Code settings
.claude/settings.local.json