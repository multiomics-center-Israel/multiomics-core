# Copy this file to .Renviron and fill in your path:
#   cp .Renviron.example .Renviron
#
# The pipeline reads this variable to locate your project config.
# If unset, it defaults to "config.yaml" in the project root.
MULTIOMICS_CONFIG=/path/to/your/config.yaml

# Path to the pinned mummichog venv's Python interpreter. Only needed when the
# metabolomics mummichog stage is enabled. Leave it COMMENTED to use the
# platform-aware default (envs/mummichog/bin/python on Unix,
# envs/mummichog/Scripts/python.exe on Windows). To pin an explicit path, run
# `make setup` — it prints the exact line for your machine — then uncomment and
# set it below. An ABSOLUTE path is the most robust
# (e.g. /home/you/multiomics-core/envs/mummichog/bin/python).
# MUMMICHOG_PYTHON=envs/mummichog/bin/python
